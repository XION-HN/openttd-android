+
+/** @file music_driver_android.h Playing music through Android's MediaPlayer. */
+
+#ifndef MUSIC_MUSIC_DRIVER_ANDROID_H
+#define MUSIC_MUSIC_DRIVER_ANDROID_H
+
+#include "music_driver.hpp"
+
+/**
+ * Music driver that hands the song file over to Android's MediaPlayer through
+ * the org.openttd.sdl.AndroidMusicPlayer Java class.
+ *
+ * MediaPlayer cannot play MIDI, so this driver is meant for music sets that
+ * ship real audio files (OGG/MP3/WAV/FLAC) instead of .mid files.
+ */
+class MusicDriver_Android : public MusicDriver {
+private:
+	uint8_t vol = 0; ///< The current volume, in percent.
+
+public:
+	std::optional<std::string_view> Start(const StringList &parm) override;
+	void Stop() override;
+	void PlaySong(const MusicSongInfo &song) override;
+	void StopSong() override;
+	bool IsSongPlaying() override;
+	void SetVolume(uint8_t vol) override;
+	std::string_view GetName() const override { return "Android MediaPlayer Music Driver"; }
+
+	~MusicDriver_Android() override { this->Stop(); }
+};
+
+/** Factory for the Android MediaPlayer music driver. */
+class FMusicDriver_Android : public DriverFactoryBase {
+public:
+	FMusicDriver_Android() : DriverFactoryBase(Driver::DT_MUSIC, 1, "android", "Android MediaPlayer Music Driver") {}
+	std::unique_ptr<Driver> CreateInstance() const override { return std::make_unique<MusicDriver_Android>(); }
+};
+
+#endif /* MUSIC_MUSIC_DRIVER_ANDROID_H */
