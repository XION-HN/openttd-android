+ */
+
+/** @file music_driver_android.cpp Playing music through Android's MediaPlayer. */
+
+#include "../stdafx.h"
+#include "../debug.h"
+#include "music_driver_android.h"
+#include "midifile.hpp"
+#include "../base_media_music.h"
+
+#ifdef __ANDROID__
+#	include <jni.h>
+#	include <SDL_system.h>
+#endif
+
+#include "../safeguards.h"
+
+/** The factory for the Android MediaPlayer music driver. */
+static FMusicDriver_Android iFMusicDriver_Android;
+
+#ifdef __ANDROID__
+
+/** The Java class that does the actual playback, obtained through SDL. */
+static jclass _music_player_class = nullptr;
+static jmethodID _music_player_play = nullptr;
+static jmethodID _music_player_stop = nullptr;
+static jmethodID _music_player_set_volume = nullptr;
+static jmethodID _music_player_is_playing = nullptr;
+
+/**
+ * Get the JNI environment of the current thread.
+ * @return The JNI environment, or \c nullptr when it is not available.
+ */
+static JNIEnv *AndroidGetJNIEnv()
+{
+	JNIEnv *env = static_cast<JNIEnv *>(SDL_AndroidGetJNIEnv());
+	if (env == nullptr) Debug(misc, 0, "Android JNI environment is unavailable");
+	return env;
+}
+
+/**
+ * Look up the Java music player class and its methods once.
+ * @param env The JNI environment.
+ * @return \c true when the class and all methods are available.
+ */
+static bool AndroidEnsureMusicPlayer(JNIEnv *env)
+{
+	if (_music_player_class != nullptr) return true;
+
+	jclass cls = env->FindClass("org/openttd/sdl/AndroidMusicPlayer");
+	if (cls == nullptr) {
+		env->ExceptionClear();
+		Debug(misc, 0, "Android music player class not found");
+		return false;
+	}
+
+	_music_player_class = static_cast<jclass>(env->NewGlobalRef(cls));
+	env->DeleteLocalRef(cls);
+	if (_music_player_class == nullptr) return false;
+
+	_music_player_play = env->GetStaticMethodID(_music_player_class, "play", "(Ljava/lang/String;F)V");
+	_music_player_stop = env->GetStaticMethodID(_music_player_class, "stop", "()V");
+	_music_player_set_volume = env->GetStaticMethodID(_music_player_class, "setVolume", "(F)V");
+	_music_player_is_playing = env->GetStaticMethodID(_music_player_class, "isPlaying", "()Z");
+
+	if (env->ExceptionCheck()) {
+		env->ExceptionClear();
+		Debug(misc, 0, "Android music player methods not found");
+		return false;
+	}
+	return true;
+}
+
+std::optional<std::string_view> MusicDriver_Android::Start([[maybe_unused]] const StringList &parm)
+{
+	JNIEnv *env = AndroidGetJNIEnv();
+	if (env == nullptr || !AndroidEnsureMusicPlayer(env)) return "the Android music player is not available";
+
+	return std::nullopt;
+}
+
+void MusicDriver_Android::Stop()
+{
+	JNIEnv *env = AndroidGetJNIEnv();
+	if (env == nullptr || !AndroidEnsureMusicPlayer(env)) return;
+
+	env->CallStaticVoidMethod(_music_player_class, _music_player_stop);
+	if (env->ExceptionCheck()) env->ExceptionClear();
+}
+
+void MusicDriver_Android::PlaySong(const MusicSongInfo &song)
+{
+	/* MediaPlayer plays real audio files; MIDI is handed over as-is and will
+	 * simply fail to play, which AndroidMusicPlayer handles gracefully. */
+	std::string filename = MidiFile::GetSMFFile(song);
+	if (filename.empty()) {
+		Debug(misc, 3, "Android music driver: could not find the file for song '{}'", song.songname);
+		return;
+	}
+
+	JNIEnv *env = AndroidGetJNIEnv();
+	if (env == nullptr || !AndroidEnsureMusicPlayer(env)) return;
+
+	jstring path = env->NewStringUTF(filename.c_str());
+	if (path == nullptr) {
+		env->ExceptionClear();
+		return;
+	}
+
+	env->CallStaticVoidMethod(_music_player_class, _music_player_play, path, static_cast<jfloat>(this->vol / 100.0));
+	if (env->ExceptionCheck()) env->ExceptionClear();
+	env->DeleteLocalRef(path);
+}
+
+void MusicDriver_Android::StopSong()
+{
+	JNIEnv *env = AndroidGetJNIEnv();
+	if (env == nullptr || !AndroidEnsureMusicPlayer(env)) return;
+
+	env->CallStaticVoidMethod(_music_player_class, _music_player_stop);
+	if (env->ExceptionCheck()) env->ExceptionClear();
+}
+
+bool MusicDriver_Android::IsSongPlaying()
+{
+	JNIEnv *env = AndroidGetJNIEnv();
+	if (env == nullptr || !AndroidEnsureMusicPlayer(env)) return false;
+
+	jboolean playing = env->CallStaticBooleanMethod(_music_player_class, _music_player_is_playing);
+	if (env->ExceptionCheck()) {
+		env->ExceptionClear();
+		return false;
+	}
+	return playing == JNI_TRUE;
+}
+
+void MusicDriver_Android::SetVolume(uint8_t vol)
+{
+	this->vol = vol;
+
+	JNIEnv *env = AndroidGetJNIEnv();
+	if (env == nullptr || !AndroidEnsureMusicPlayer(env)) return;
+
+	env->CallStaticVoidMethod(_music_player_class, _music_player_set_volume, static_cast<jfloat>(vol / 100.0));
+	if (env->ExceptionCheck()) env->ExceptionClear();
+}
+
+#else /* __ANDROID__ */
+
+std::optional<std::string_view> MusicDriver_Android::Start(const StringList &) { return "not supported on this platform"; }
+void MusicDriver_Android::Stop() {}
+void MusicDriver_Android::PlaySong(const MusicSongInfo &) {}
+void MusicDriver_Android::StopSong() {}
+bool MusicDriver_Android::IsSongPlaying() { return false; }
+void MusicDriver_Android::SetVolume(uint8_t) {}
+
+#endif /* __ANDROID__ */
