+/** @file sdl2_mixer_m.cpp Playing music via SDL2_mixer, which supports compressed audio (Ogg, MP3, FLAC, ...). */
+
+#ifdef WITH_SDL2_MIXER
+
+#include "../stdafx.h"
+#include "../debug.h"
+#include "sdl2_mixer_m.h"
+#include "midifile.hpp"
+#include <SDL_mixer.h>
+
+#include "../safeguards.h"
+
+static FMusicDriver_SDL2Mixer iFMusicDriver_SDL2Mixer;
+
+/** Currently loaded/played music, owned by us. */
+static Mix_Music *_mixer_music = nullptr;
+
+std::optional<std::string_view> MusicDriver_SDL2Mixer::Start(const StringList &)
+{
+	int wanted = 0;
+#ifdef MIX_INIT_OGG
+	wanted |= MIX_INIT_OGG;
+#endif
+#ifdef MIX_INIT_MP3
+	wanted |= MIX_INIT_MP3;
+#endif
+#ifdef MIX_INIT_FLAC
+	wanted |= MIX_INIT_FLAC;
+#endif
+#ifdef MIX_INIT_MOD
+	wanted |= MIX_INIT_MOD;
+#endif
+
+	if ((Mix_Init(wanted) & wanted) != wanted) {
+		Debug(misc, 0, "sdl2mixer: Mix_Init failed: {}", Mix_GetError());
+		return "Failed to initialise the required SDL_mixer decoders";
+	}
+
+	if (Mix_OpenAudio(48000, AUDIO_S16SYS, 2, 4096) < 0) {
+		Debug(misc, 0, "sdl2mixer: Mix_OpenAudio failed: {}", Mix_GetError());
+		return "Failed to open the SDL_mixer audio device";
+	}
+
+	Mix_VolumeMusic(MIX_MAX_VOLUME);
+	return std::nullopt;
+}
+
+void MusicDriver_SDL2Mixer::Stop()
+{
+	if (_mixer_music != nullptr) {
+		Mix_HaltMusic();
+		Mix_FreeMusic(_mixer_music);
+		_mixer_music = nullptr;
+	}
+	Mix_CloseAudio();
+	Mix_Quit();
+}
+
+void MusicDriver_SDL2Mixer::PlaySong(const MusicSongInfo &song)
+{
+	if (_mixer_music != nullptr) {
+		Mix_HaltMusic();
+		Mix_FreeMusic(_mixer_music);
+		_mixer_music = nullptr;
+	}
+
+	/* GetSMFFile() resolves the path for any file listed as a "standard MIDI"
+	 * entry in the .obm; it does not care that the file is actually Ogg. */
+	std::string filename = MidiFile::GetSMFFile(song);
+	if (filename.empty()) return;
+
+	_mixer_music = Mix_LoadMUS(filename.c_str());
+	if (_mixer_music == nullptr) {
+		Debug(misc, 1, "sdl2mixer: cannot load '{}': {}", filename, Mix_GetError());
+		return;
+	}
+	Mix_PlayMusic(_mixer_music, 0);
+}
+
+void MusicDriver_SDL2Mixer::StopSong()
+{
+	Mix_HaltMusic();
+}
+
+bool MusicDriver_SDL2Mixer::IsSongPlaying()
+{
+	return Mix_PlayingMusic() != 0;
+}
+
+void MusicDriver_SDL2Mixer::SetVolume(uint8_t vol)
+{
+	/* OpenTTD volume is 0..128, which matches MIX_MAX_VOLUME. */
+	Mix_VolumeMusic(vol);
+}
+
+#endif /* WITH_SDL2_MIXER */
