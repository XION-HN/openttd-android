+
+/** @file sdl2_mixer_m.h Base for playing music via SDL2_mixer (Ogg/MP3/FLAC/MOD/WAV). */
+
+#ifndef MUSIC_SDL2_MIXER_H
+#define MUSIC_SDL2_MIXER_H
+
+#include "music_driver.hpp"
+
+/** The music player that uses SDL2_mixer. */
+class MusicDriver_SDL2Mixer : public MusicDriver {
+public:
+	std::optional<std::string_view> Start(const StringList &param) override;
+
+	void Stop() override;
+
+	void PlaySong(const MusicSongInfo &song) override;
+
+	void StopSong() override;
+
+	bool IsSongPlaying() override;
+
+	void SetVolume(uint8_t vol) override;
+	std::string_view GetName() const override { return "sdl2mixer"; }
+};
+
+/** Factory for the SDL2_mixer music player. */
+class FMusicDriver_SDL2Mixer : public DriverFactoryBase {
+public:
+	static const int PRIORITY = 8;
+	FMusicDriver_SDL2Mixer() : DriverFactoryBase(Driver::DT_MUSIC, PRIORITY, "sdl2mixer", "SDL2_mixer Music Driver (Ogg/MP3/FLAC)") {}
+	std::unique_ptr<Driver> CreateInstance() const override { return std::make_unique<MusicDriver_SDL2Mixer>(); }
+};
+
+#endif /* MUSIC_SDL2_MIXER_H */
