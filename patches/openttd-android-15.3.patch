+
+/** @file android_crash.cpp Android 端崩溃捕获：native 信号 + 写 sdcard。 */
+
+#ifdef __ANDROID__
+
+#include <jni.h>
+#include <android/log.h>
+
+#include <cstdint>
+#include <cstdlib>
+#include <cstdio>
+#include <cstring>
+#include <ctime>
+
+#include <dlfcn.h>
+#include <fcntl.h>
+#include <link.h>
+#include <signal.h>
+#include <sys/types.h>
+#include <ucontext.h>
+#include <unistd.h>
+#include <unwind.h>
+
+#ifndef OTTD_ANDROID_CRASH_TAG
+#define OTTD_ANDROID_CRASH_TAG "OpenTTD-crash"
+#endif
+
+static int g_crash_fd = -1;
+static volatile sig_atomic_t g_in_crash = 0;
+
+/* 信号处理里只能用异步信号安全的操作，这里只用 write()。 */
+static void RawWrite(const char *s, size_t n)
+{
+	if (g_crash_fd < 0 || s == nullptr) return;
+	ssize_t unused = write(g_crash_fd, s, n);
+	(void)unused;
+}
+
+static void RawStr(const char *s)
+{
+	if (s != nullptr) RawWrite(s, strlen(s));
+}
+
+static void RawHex(uint64_t v)
+{
+	static const char hex[] = "0123456789abcdef";
+	char buf[3 + 16 + 2];
+	buf[0] = '0';
+	buf[1] = 'x';
+	for (int i = 0; i < 16; i++) {
+		buf[2 + i] = hex[(v >> ((15 - i) * 4)) & 0xF];
+	}
+	buf[18] = '\n';
+	buf[19] = '\0';
+	RawWrite(buf, 19);
+}
+
+static void RawDec(long v)
+{
+	char buf[32];
+	int n = snprintf(buf, sizeof(buf), "%ld", v);
+	if (n > 0) RawWrite(buf, static_cast<size_t>(n));
+}
+
+static const char *SignalName(int sig)
+{
+	switch (sig) {
+		case SIGSEGV: return "SIGSEGV";
+		case SIGABRT: return "SIGABRT";
+		case SIGBUS:  return "SIGBUS";
+		case SIGFPE:  return "SIGFPE";
+		case SIGILL:  return "SIGILL";
+		case SIGTRAP: return "SIGTRAP";
+		default:      return "UNKNOWN";
+	}
+}
+
+/* 用 libunwind 回溯（不依赖 frame pointer）。 */
+struct UnwindState {
+	int index;
+};
+
+static _Unwind_Reason_Code UnwindCallback(struct _Unwind_Context *ctx, void *arg)
+{
+	UnwindState *state = static_cast<UnwindState *>(arg);
+	uintptr_t pc = static_cast<uintptr_t>(_Unwind_GetIP(ctx));
+	if (pc == 0) return _URC_END_OF_STACK;
+	if (state->index >= 64) return _URC_END_OF_STACK;
+	RawStr("  #");
+	RawDec(state->index++);
+	RawStr(" pc=");
+	RawHex(pc);
+	return _URC_NO_REASON;
+}
+
+/* 弱符号：老系统上不存在，存在时能拿到 bionic 的 abort message。 */
+extern "C" const char *android_get_abort_message(void) __attribute__((weak));
+
+static void CrashHandler(int sig, siginfo_t *info, void *uctx)
+{
+	/* 第一次进来写报告；报告本身再触发信号就立刻退出，避免死循环。 */
+	if (g_in_crash) {
+		signal(sig, SIG_DFL);
+		raise(sig);
+		_exit(128 + sig);
+	}
+	g_in_crash = 1;
+
+	RawStr("\n\n=== NATIVE CRASH ===\n");
+	RawStr("signal: ");
+	RawStr(SignalName(sig));
+	RawStr("\nsignal_no: ");
+	RawDec(sig);
+	RawStr("\ncode: ");
+	RawDec(info != nullptr ? info->si_code : -1);
+	RawStr("\nfault_addr: ");
+	RawHex(info != nullptr ? reinterpret_cast<uint64_t>(info->si_addr) : 0);
+
+	if (android_get_abort_message != nullptr) {
+		const char *msg = android_get_abort_message();
+		if (msg != nullptr) {
+			RawStr("abort_message: ");
+			RawStr(msg);
+			RawStr("\n");
+		}
+	}
+
+	ucontext_t *uc = static_cast<ucontext_t *>(uctx);
+	if (uc != nullptr) {
+#if defined(__aarch64__)
+		RawStr("pc: ");  RawHex(uc->uc_mcontext.pc);
+		RawStr("lr: ");  RawHex(uc->uc_mcontext.regs[30]);
+		RawStr("sp: ");  RawHex(uc->uc_mcontext.sp);
+		RawStr("fp: ");  RawHex(uc->uc_mcontext.regs[29]);
+#elif defined(__arm__)
+		RawStr("pc: ");  RawHex(uc->uc_mcontext.arm_pc);
+		RawStr("lr: ");  RawHex(uc->uc_mcontext.arm_lr);
+		RawStr("sp: ");  RawHex(uc->uc_mcontext.arm_sp);
+		RawStr("fp: ");  RawHex(uc->uc_mcontext.arm_fp);
+#endif
+	}
+
+	RawStr("backtrace:\n");
+	UnwindState state{0};
+	_Unwind_Backtrace(UnwindCallback, &state);
+
+	RawStr("=== END NATIVE CRASH ===\n");
+	if (g_crash_fd >= 0) fsync(g_crash_fd);
+
+	/* 还原默认处理，让系统按原信号结束进程（便于 Google Play/系统统计）。 */
+	signal(sig, SIG_DFL);
+	raise(sig);
+	_exit(128 + sig);
+}
+
+/* 备用信号栈：捕获栈溢出（SIGSEGV 时原栈可能不可用）。 */
+static char g_alt_stack[64 * 1024] __attribute__((aligned(16)));
+
+static void InstallCrashHandlers()
+{
+	stack_t ss;
+	memset(&ss, 0, sizeof(ss));
+	ss.ss_sp = g_alt_stack;
+	ss.ss_size = sizeof(g_alt_stack);
+	ss.ss_flags = 0;
+	sigaltstack(&ss, nullptr);
+
+	struct sigaction sa;
+	memset(&sa, 0, sizeof(sa));
+	sa.sa_sigaction = CrashHandler;
+	sa.sa_flags = SA_SIGINFO | SA_ONSTACK | SA_RESTART;
+	sigemptyset(&sa.sa_mask);
+
+	static const int signals[] = {SIGSEGV, SIGABRT, SIGBUS, SIGFPE, SIGILL, SIGTRAP};
+	for (int sig : signals) {
+		sigaction(sig, &sa, nullptr);
+	}
+}
+
+static void WriteHeader()
+{
+	RawStr("\n================ OpenTTD Android crash log ================\n");
+
+	time_t now = time(nullptr);
+	char timebuf[64] = {0};
+	struct tm tm_buf;
+	if (gmtime_r(&now, &tm_buf) != nullptr) {
+		strftime(timebuf, sizeof(timebuf), "%Y-%m-%d %H:%M:%S UTC", &tm_buf);
+	}
+	RawStr("time: ");  RawStr(timebuf); RawStr("\n");
+	RawStr("pid: ");   RawDec(getpid()); RawStr("\n");
+	RawStr("uid: ");   RawDec(getuid()); RawStr("\n");
+
+	char cwd[512] = {0};
+	if (getcwd(cwd, sizeof(cwd)) != nullptr) {
+		RawStr("cwd: "); RawStr(cwd); RawStr("\n");
+	}
+	const char *home = getenv("HOME");
+	if (home != nullptr) {
+		RawStr("HOME: "); RawStr(home); RawStr("\n");
+	}
+
+	/* 写出 /proc/self/maps，方便事后把 PC 换算成 libmain.so 偏移。 */
+	RawStr("--- /proc/self/maps ---\n");
+	int fd = open("/proc/self/maps", O_RDONLY | O_CLOEXEC);
+	if (fd >= 0) {
+		char buf[4096];
+		ssize_t n;
+		while ((n = read(fd, buf, sizeof(buf))) > 0) {
+			ssize_t off = 0;
+			while (off < n) {
+				ssize_t w = write(g_crash_fd, buf + off, static_cast<size_t>(n - off));
+				if (w <= 0) break;
+				off += w;
+			}
+		}
+		close(fd);
+	}
+	RawStr("--- end maps ---\n");
+	RawStr("===========================================================\n");
+}
+
+extern "C" void AndroidCrash_Setup(int fd, const char *app_version)
+{
+	if (fd < 0) return;
+	g_crash_fd = fd;
+
+	RawStr("app_version: "); RawStr(app_version != nullptr ? app_version : "(unknown)"); RawStr("\n");
+#if defined(__aarch64__)
+	RawStr("native_arch: arm64-v8a\n");
+#elif defined(__arm__)
+	RawStr("native_arch: armeabi-v7a\n");
+#else
+	RawStr("native_arch: other\n");
+#endif
+	WriteHeader();
+
+	/* 把 native 的 stdout/stderr 也导到崩溃日志，捕获 OpenTTD/SDL 的报错。 */
+	int err_fd = dup(fd);
+	if (err_fd >= 0) {
+		dup2(err_fd, STDOUT_FILENO);
+		dup2(err_fd, STDERR_FILENO);
+		close(err_fd);
+	}
+
+	RawStr("[native] crash handlers installed\n");
+	InstallCrashHandlers();
+}
+
+/* OpenTTD 自己也会装 crash handler（写私有目录），在它之后再装一次，保证我们的生效。 */
+extern "C" void AndroidCrash_InstallAfterOpenTTDInit()
+{
+	if (g_crash_fd < 0) return;
+	RawStr("[native] reinstalling crash handlers after OpenTTD CrashLog init\n");
+	InstallCrashHandlers();
+}
+
+extern "C" JNIEXPORT void JNICALL
+Java_org_openttd_sdl_MainActivity_nativeSetupCrashHandler(JNIEnv *env, jclass, jint fd, jstring app_version)
+{
+	const char *version = app_version != nullptr ? env->GetStringUTFChars(app_version, nullptr) : nullptr;
+	AndroidCrash_Setup(fd, version);
+	if (version != nullptr) env->ReleaseStringUTFChars(app_version, version);
+}
+
+extern "C" JNIEXPORT void JNICALL
+Java_org_openttd_sdl_MainActivity_nativeLogMarker(JNIEnv *env, jclass, jstring msg)
+{
+	if (g_crash_fd < 0 || msg == nullptr) return;
+	const char *s = env->GetStringUTFChars(msg, nullptr);
+	RawStr(s);
+	RawStr("\n");
+	if (s != nullptr) env->ReleaseStringUTFChars(msg, s);
+}
+
+#endif /* __ANDROID__ */
